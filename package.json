{
  "name": "sigelab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:env": "tsx --env-file=.env.local scripts/check-env.ts",
    "test:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.mts",
    "test:e2e": "playwright test",
    "verify:supabase": "tsx --env-file=.env.local scripts/verify-supabase.mts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "qr:generate": "tsx scripts/generate-qr-examples.mts",
    "postinstall": "node scripts/patch-opennext-cookie.mjs",
    "build:cloudflare": "node scripts/patch-opennext-cookie.mjs && opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "test:cloudflare": "PLAYWRIGHT_BASE_URL=http://localhost:3300 playwright test e2e/cloudflare-cookies.spec.ts e2e/authenticated-pages.spec.ts",
    "prebuild": "node scripts/check-build-env.mjs && node scripts/patch-opennext-cookie.mjs",
    "test:responsive": "playwright test e2e/layout.spec.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@opennextjs/cloudflare": "1.20.18",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "jsqr": "1.4.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "14.0.6"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
